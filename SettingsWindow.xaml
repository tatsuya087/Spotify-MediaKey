<ui:FluentWindow x:Class="SpotifyMediaKey.SettingsWindow"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify MediaKey"
                 Width="460"
                 Height="530"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Spotify MediaKey" />

        <StackPanel Grid.Row="1" Margin="26,0,26,0">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Medium" Margin="0,0,0,20" />

            <TextBlock x:Name="LanguageLabel" FontSize="13" Foreground="#B3B3B3" Margin="0,0,0,8" />
            <ComboBox x:Name="LanguageComboBox" Margin="0,0,0,20" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="日本語" Tag="ja" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>

            <CheckBox x:Name="AutoStartCheckBox" Margin="0,0,0,20" Padding="0,0,0,0"
          Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed" />

            <TextBlock x:Name="StepLabel" FontSize="13" Foreground="#B3B3B3" Margin="0,0,0,8" />
            <Grid Margin="10,0,10,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="StepSlider" Grid.Column="0" Minimum="1" Maximum="10" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="StepSlider_ValueChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="StepValueText" Grid.Column="1"
                           VerticalAlignment="Center" Margin="8,0,10,0" Text="2%" />
            </Grid>

            <TextBlock x:Name="OsdModeLabel" FontSize="13" Foreground="#B3B3B3" Margin="0,0,0,8" />
            <RadioButton x:Name="OsdOffRadio" GroupName="OsdMode" Margin="8,0,0,8" Checked="OsdMode_Changed" />
            <RadioButton x:Name="OsdKeyPressRadio" GroupName="OsdMode" Margin="8,0,0,8" Checked="OsdMode_Changed" />
            <RadioButton x:Name="OsdAlwaysRadio" GroupName="OsdMode" Margin="8,0,0,16" Checked="OsdMode_Changed" />

            <TextBlock x:Name="OsdPositionLabel" FontSize="13" Foreground="#B3B3B3" Margin="0,0,0,8" />
            <ComboBox x:Name="OsdPositionComboBox" Margin="0,0,0,0" SelectionChanged="OsdPositionComboBox_SelectionChanged">
                <ComboBoxItem Content="Top Right" Tag="TopRight" />
                <ComboBoxItem Content="Bottom Right" Tag="BottomRight" />
                <ComboBoxItem Content="Top Left" Tag="TopLeft" />
                <ComboBoxItem Content="Bottom Left" Tag="BottomLeft" />
            </ComboBox>
        </StackPanel>
    </Grid>
</ui:FluentWindow>