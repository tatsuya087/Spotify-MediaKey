<ui:FluentWindow x:Class="SpotifyMediaKey.ClientIdSetupWindow"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify MediaKey" Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Spotify MediaKey" />

        <StackPanel Grid.Row="1" Margin="24,0,24,24">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Medium" Margin="0,0,0,12" />
            <TextBlock x:Name="LanguageLabel" FontSize="13" Opacity="0.6" Margin="0,0,0,8" />
            <ComboBox x:Name="LanguageComboBox" Margin="0,0,0,16" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="日本語" Tag="ja" />
            </ComboBox>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="13" Opacity="0.7" Margin="0,0,0,16" />

            <Button x:Name="OpenDashboardButton" HorizontalAlignment="Stretch" Margin="0,0,0,20" Click="OpenDashboard_Click" />

            <TextBlock x:Name="RedirectUriLabel" FontSize="13" Opacity="0.6" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="http://127.0.0.1:8888/callback" IsReadOnly="True" Margin="0,0,8,0" />
                <Button x:Name="CopyButton" Grid.Column="1" Click="CopyRedirectUri_Click" />
            </Grid>

            <TextBlock x:Name="ClientIdLabel" FontSize="13" Opacity="0.6" Margin="0,0,0,8" />
            <TextBox x:Name="ClientIdTextBox" Margin="0,0,0,8" />
            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12" Visibility="Collapsed" Margin="0,0,0,12" />

            <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Button x:Name="StartButtonText" HorizontalAlignment="Right" Width="100" Click="StartButton_Click" />
            </Border>
        </StackPanel>
    </Grid>
</ui:FluentWindow>