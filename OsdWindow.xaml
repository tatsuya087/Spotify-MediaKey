<Window x:Class="SpotifyMediaKey.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="320"
        Height="120"
        WindowStartupLocation="Manual">
    <Border Background="#CC000000" CornerRadius="12" Padding="16,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,6,0" />
                <TextBlock Text="Spotify MediaKey" Foreground="#CFCFCF" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                    <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackNameText" Foreground="White" FontSize="14" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" Text="Track name" />
                    <TextBlock x:Name="ArtistNameText" Foreground="White" Opacity="0.7" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,6" Text="Artist name" />
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="14" FontWeight="Medium" Text="50%" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>